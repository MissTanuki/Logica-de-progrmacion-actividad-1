//laura tiene 17 pero buscamos persona mayores o = a 20 años para encuestarla
Algoritmo encuesta
	definir Laura Como entero //aqui definimos Laura
	Laura = 17 //Laura tiene 17 años
	si Laura >= 20; //si es >= a 20 años
		Escribir ("Puede ser encuentada")// se puede encuestar
	sino; //si no 
		Escribir ("No puede ser encuestada") //no puede
	FinSi//fin de las opciones
FinAlgoritmo //fin del algoritmo
