Proceso Aritmetica
	definir a Como Entero;
	Escribir "Ingrese un número:";
	leer a;
	definir b Como Entero;
	Escribir "Ingrese un número:";
	leer b;
	definir c Como Entero;
	Escribir "Ingrese un número:";
	leer c;
	definir d Como Entero;
	Escribir "Ingrese un número:";
	leer d;
	resultado <- (((a + b)- 4) ^ 2) / (c * d)
	escribir ("resultado"),resultado
	
FinProceso

